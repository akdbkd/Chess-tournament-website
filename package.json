{
  "name": "knightfall-arena",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "format": "prettier --write src tests scripts next.config.ts",
    "test:browser": "node tests/browser.cjs",
    "prebuild": "node --env-file-if-exists=.env.local scripts/check-environment.mjs",
    "check:production": "node --env-file-if-exists=.env.local scripts/check-environment.mjs --production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
