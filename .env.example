# Public Supabase project settings (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to false for launch. Demo mode has no real payments or shared data.
NEXT_PUBLIC_DEMO_MODE=false
# Server only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Canonical Vercel or custom domain, no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: existing organizer UUID for the staging seed
# SEED_ORGANIZER_ID=

# Optional scheduler authorization, at least 32 random characters
CRON_SECRET=
